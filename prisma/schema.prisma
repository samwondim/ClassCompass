// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  ADMIN
  TEACHER
}

// ---------- MODELS ----------
model User {
  user_id          String           @id @default(uuid())
  user_role        UserRole?        @default(TEACHER)
  tg_id            Float?           @unique
  tg_username      String           @unique
  first_name       String?
  last_name        String?
  photo_url        String?
  phone_number     String?          @unique
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  // Relations
  sections_managed Section[]        @relation("ManagerSections")
  teacher_sections TeacherSection[]
  schedules        Schedule[]
  courses_created  Course[]         @relation("CreatedCourses")
  ManagerSection   ManagerSection[]
  notifications    Notification[]
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String
  type       String   @default("info") // info, warning, success, error
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  link       String?

  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Section {
  section_id       String           @id @default(uuid())
  section_name     String
  manager_id       String?
  manager          User?            @relation("ManagerSections", fields: [manager_id], references: [user_id], onDelete: SetNull)
  teacher_sections TeacherSection[]
  ManagerSection   ManagerSection[]
  schedules        Schedule[]
}

model TeacherSection {
  id         String  @id @default(uuid())
  teacher_id String
  section_id String
  teacher    User    @relation(fields: [teacher_id], references: [user_id], onDelete: Cascade)
  section    Section @relation(fields: [section_id], references: [section_id], onDelete: Cascade)

  @@unique([teacher_id, section_id])
}

model ManagerSection {
  id         String  @id @default(uuid())
  manager_id String
  section_id String
  manager    User    @relation(fields: [manager_id], references: [user_id], onDelete: Cascade)
  section    Section @relation(fields: [section_id], references: [section_id], onDelete: Cascade)

  @@unique([manager_id, section_id])
}

model Schedule {
  schedule_id   String   @id @default(uuid())
  course_id     String
  section_id    String
  teacher_id    String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  schedule_date DateTime
  // Relations
  course        Course   @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  section       Section  @relation(fields: [section_id], references: [section_id], onDelete: Cascade)
  teacher       User     @relation(fields: [teacher_id], references: [user_id], onDelete: Cascade)
}

model Course {
  course_id          String      @id @default(uuid())
  course_name        String?
  verse              String?
  course_description String?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt
  created_by         String
  created_by_user    User        @relation("CreatedCourses", fields: [created_by], references: [user_id], onDelete: Cascade)
  objectives         Objective[]
  schedules          Schedule[]
}

model Objective {
  id        String @id @default(uuid())
  objective String
  course_id String
  course    Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
}
