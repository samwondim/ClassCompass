// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  ADMIN
  TEACHER
}

enum ResourceType {
  FILE
  LINK
  IMAGE
  VIDEO
}

// ---------- MODELS ----------
model User {
  user_id          String           @id @default(uuid())
  user_role        UserRole?        @default(TEACHER)
  tg_id            String?          @unique
  tg_username      String           @unique
  first_name       String?
  last_name        String?
  photo_url        String?
  phone_number     String?          @unique
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  // Relations
  sections_managed Section[]        @relation("ManagerSections")
  teacher_sections TeacherSection[]
  schedules        Schedule[]
  courses_created  Course[]         @relation("CreatedCourses")
  ManagerSection   ManagerSection[]
  notifications    Notification[]
  units_created    CurriculumUnit[] @relation("UnitCreator")
  resources        Resource[]       @relation("ResourceUploader")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String
  type       String   @default("info") // info, warning, success, error
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  link       String?

  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Section {
  section_id       String           @id @default(uuid())
  section_name     String
  manager_id       String?
  manager          User?            @relation("ManagerSections", fields: [manager_id], references: [user_id], onDelete: SetNull)
  teacher_sections TeacherSection[]
  ManagerSection   ManagerSection[]
  schedules        Schedule[]
  courses          Course[]
  units            CurriculumUnit[]
  resources        Resource[]
}

model TeacherSection {
  id         String  @id @default(uuid())
  teacher_id String
  section_id String
  teacher    User    @relation(fields: [teacher_id], references: [user_id], onDelete: Cascade)
  section    Section @relation(fields: [section_id], references: [section_id], onDelete: Cascade)

  @@unique([teacher_id, section_id])
}

model ManagerSection {
  id         String  @id @default(uuid())
  manager_id String
  section_id String
  manager    User    @relation(fields: [manager_id], references: [user_id], onDelete: Cascade)
  section    Section @relation(fields: [section_id], references: [section_id], onDelete: Cascade)

  @@unique([manager_id, section_id])
}

model Schedule {
  schedule_id   String   @id @default(uuid())
  course_id     String
  section_id    String
  teacher_id    String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  schedule_date DateTime
  // Relations
  course        Course   @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  section       Section  @relation(fields: [section_id], references: [section_id], onDelete: Cascade)
  teacher       User     @relation(fields: [teacher_id], references: [user_id], onDelete: Cascade)
}

model Course {
  course_id          String      @id @default(uuid())
  course_name        String?
  verse              String?
  course_description String?
  section_id         String?
  section            Section?    @relation(fields: [section_id], references: [section_id], onDelete: SetNull)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt
  created_by         String
  created_by_user    User        @relation("CreatedCourses", fields: [created_by], references: [user_id], onDelete: Cascade)
  objectives         Objective[]
  schedules          Schedule[]

  // Curriculum fields
  unit_id          String?
  unit             CurriculumUnit? @relation(fields: [unit_id], references: [unit_id], onDelete: SetNull)
  order            Int?            @default(0)
  duration_minutes Int?
  age_group        String?
  lesson_plan      Json?
  resources        Resource[]

  @@index([unit_id])
}

model CurriculumUnit {
  unit_id     String   @id @default(uuid())
  title       String
  description String?
  order       Int      @default(0)
  period      String?
  section_id  String
  created_by  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  section         Section  @relation(fields: [section_id], references: [section_id], onDelete: Cascade)
  created_by_user User     @relation("UnitCreator", fields: [created_by], references: [user_id], onDelete: Cascade)
  courses         Course[]

  @@index([section_id])
}

model Resource {
  resource_id  String       @id @default(uuid())
  title        String
  type         ResourceType @default(FILE)
  url          String
  mime_type    String?
  size         Int?
  course_id    String?
  section_id   String?
  uploaded_by  String
  created_at   DateTime     @default(now())

  course           Course?  @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  section          Section? @relation(fields: [section_id], references: [section_id], onDelete: Cascade)
  uploaded_by_user User     @relation("ResourceUploader", fields: [uploaded_by], references: [user_id], onDelete: Cascade)

  @@index([course_id])
  @@index([section_id])
}

model AppSettings {
  id                     String   @id @default("app")
  app_name               String   @default("Sunday School Reminder")
  bot_description        String?
  bot_short_description  String?
  updated_at             DateTime @updatedAt
  updated_by             String?
}

model Objective {
  id        String @id @default(uuid())
  objective String
  course_id String
  course    Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
}
