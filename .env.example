# Database
DATABASE_URL="postgresql://user:password@localhost:5432/classcompass"

# Session signing (JWT) - must be at least 32 characters
JWT_SECRET=""

# Telegram bot token (used for initData validation AND message sending)
TELEGRAM_API_KEY=""
# Alias accepted for notifications (falls back to TELEGRAM_API_KEY)
BOT_TOKEN=""

# Cron protection - required to trigger /api/cron/* endpoints
CRON_SECRET=""

# Local development browser login (NEVER enable in production)
# When true, the login screen shows a "dev login" panel to pick a seeded user.
NEXT_PUBLIC_DEV_LOGIN="false"
ALLOW_DEV_LOGIN="false"

# Mini app base URL for deep links
NEXT_PUBLIC_BASE_URL="https://t.me/your_bot/app"

# The app's own origin (used for CORS allowlist and server-side API calls)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Vercel Blob storage for lesson resources
BLOB_READ_WRITE_TOKEN=""

# Timezone for reminder rendering (defaults to Africa/Addis_Ababa)
APP_TIMEZONE="Africa/Addis_Ababa"
